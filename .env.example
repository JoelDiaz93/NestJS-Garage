NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
SWAGGER_ENABLED=true

# Local PostgreSQL (used when DATABASE_URL is empty)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=garageflow
DB_USERNAME=postgres
DB_PASSWORD=change_me_local_only
DB_POOL_MAX=5
DB_SYNC=false
DB_MIGRATIONS_RUN=false
DB_SSL=false

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

TAX_RATE=0.15
QUOTE_VALIDITY_DAYS=15

# local | cloudinary
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For a public portfolio demo only. Keep false in a real production environment.
DEMO_MODE=false
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@garageflow.local
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
